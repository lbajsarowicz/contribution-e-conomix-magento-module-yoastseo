{
  "name": "e-conomix/magento-module-yoastseo",
  "description": "Yoast SEO integration by MaxServ",
  "version": "2.0.7",
  "require": {
    "magento/framework": "^101.0|^102.0|^103.0",
    "magento/module-catalog": "*",
    "magento/module-cms": "*",
    "magento/module-config": "*"
  },
  "suggest": {
  },
  "type": "magento2-module",
  "license": [
    "GPL-3.0"
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "MaxServ\\YoastSeo\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
